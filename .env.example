# AgentEscrow Environment Configuration

# Google Cloud Service Account credentials JSON file path
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json

# Google AI Studio API Key (for Gemini model)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Sheets Spreadsheet ID (Audit Ledger)
SHEET_ID=your_google_sheet_id_here

# Google Docs Document ID (Acceptance Criteria / Task Agreement)
DOC_ID=your_google_doc_id_here

# GitHub Token (Personal Access Token, read-only scope)
GITHUB_TOKEN=your_github_token_here

# GitHub Target Repository and PR to evaluate
GITHUB_REPO=owner/repo
GITHUB_PR_NUMBER=1

# Stripe Test-mode Secret Key
STRIPE_TEST_SECRET_KEY=sk_test_your_stripe_test_secret_key

# Slack Incoming Webhook URL (optional; logs to console if empty)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
